+            [
+                "vanilla_plot_base64_jpg",
+                "target_plot_desc0_base64_jpg",
+                "target_plot_critic_desc0_base64_jpg",
+                "polished_plot_base64_jpg",
+            ],
+        )
+
+    def test_relative_plot_ground_truth_path_resolves_under_benchmark_root(self) -> None:
